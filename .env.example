# ============================================================================
# Google Gemini API Configuration (PRIMARY LLM PROVIDER)
# ============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0

# ============================================================================
# Snowflake Cortex AI Configuration (FALLBACK LLM PROVIDER)
# ============================================================================
# Get these from your Snowflake admin
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# AUTHENTICATION: Choose one of:
# Option 1: Key-pair authentication (recommended for service accounts)
SNOWFLAKE_PRIVATE_KEY="""-----BEGIN PRIVATE KEY-----
your_private_key_here
-----END PRIVATE KEY-----
"""

# Option 2: Password authentication
# SNOWFLAKE_PASSWORD=your_snowflake_password

# Database & Schema
SNOWFLAKE_DATABASE=CAPSTONE_DB
SNOWFLAKE_SCHEMA=PREDICTIVE_MAINTENANCE
CORTEX_MODEL=llama3.1-8b

# ============================================================================
# LLM Provider Strategy
# ============================================================================
# Options: auto (use both with fallback), gemini (Gemini only), snowflake (Cortex only)
LLM_PRIMARY=auto
LLM_FALLBACK=auto
LLM_MAX_RETRIES=2

# ============================================================================
# LangSmith Tracing (Optional)
# ============================================================================
# 1. Go to https://smith.langchain.com
# 2. Create a project or use "Demo"
# 3. Settings → API Keys → Create API Key
# 4. Copy your API key below to enable debugging & monitoring
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=Demo
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# For APAC region (Asia-Pacific):
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# ============================================================================
# Notes
# ============================================================================
# Recommended Setup:
#   - Production: Configure both Gemini (primary) and Snowflake (fallback)
#   - Development: Use Gemini only (cheaper, faster)
#   - Testing: Use Snowflake only (no external API keys needed)
#
# If only GOOGLE_API_KEY is set:
#   → Uses Gemini API exclusively
#
# If only Snowflake credentials are set:
#   → Uses Snowflake Cortex exclusively
#
# If both are set:
#   → Uses Gemini as primary with Snowflake as automatic fallback
#   → On Gemini failure, automatically retries with Snowflake
